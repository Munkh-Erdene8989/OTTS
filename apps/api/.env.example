NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/negun
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
ADMIN_BOOTSTRAP_PHONE=+97699000000

# CallPro SMS — https://api-text.callpro.mn
SMS_PROVIDER=callpro
CALLPRO_API_KEY=
CALLPRO_FROM=
CALLPRO_BASE_URL=https://api-text.callpro.mn/v1/sms
CALLPRO_OTP_ENABLED=true
OTP_TTL_SECONDS=300
OTP_LENGTH=6

# Mux — https://www.mux.com/docs
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=
MUX_VIDEO_QUALITY=plus

# QPay Merchant V2 — https://developer.qpay.mn/mn/docs
# CLIENT_ID/SECRET are the merchant username/password from QPay.
QPAY_BASE_URL=https://merchant.qpay.mn
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=
QPAY_CALLBACK_URL=http://localhost:4000/v1/webhooks/qpay
PREMIUM_MONTHLY_PRICE_MNT=12990
